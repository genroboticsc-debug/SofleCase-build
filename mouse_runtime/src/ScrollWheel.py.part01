def _circle_midpoint(center: tuple[float, float], start: tuple[float, float], end: tuple[float, float]) -> tuple[float, float]:
    """Point half way along the short circular arc from start to end."""
    a0 = math.atan2(start[1] - center[1], start[0] - center[0])
    a1 = math.atan2(end[1] - center[1], end[0] - center[0])
    delta = (a1 - a0 + math.pi) % (2.0 * math.pi) - math.pi
    am = a0 + delta / 2.0
    return (
        center[0] + SHOULDER_ARC_RADIUS * math.cos(am),
        center[1] + SHOULDER_ARC_RADIUS * math.sin(am),
    )


def _outer_revolve_profile():
    """Closed X/R wheel profile using the exact compact master groove."""
    left_land = (LAND_TANGENCY_X, OUTER_LAND_RADIUS)
    left_groove = GROOVE_BEZIERS[0][0]
    right_groove = GROOVE_BEZIERS[-1][-1]
    right_land = (WHEEL_WIDTH - LAND_TANGENCY_X, OUTER_LAND_RADIUS)
    left_center = (SHOULDER_CENTER_X_LEFT, SHOULDER_CENTER_RADIUS)
    right_center = (SHOULDER_CENTER_X_RIGHT, SHOULDER_CENTER_RADIUS)

