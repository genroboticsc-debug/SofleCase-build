# ---------------------------------------------------------------------------
# Vector/topology helpers. All geometry stays Build123d-native.
# ---------------------------------------------------------------------------
def _v(p) -> Vector:
    return p if isinstance(p, Vector) else Vector(*p)


def _dist(a, b) -> float:
    a, b = _v(a), _v(b)
    return (a - b).length


def _mid(a, b) -> Vector:
    return (_v(a) + _v(b)) * 0.5


def _edge_ends(e: Edge) -> tuple[Vector, Vector]:
    return e.position_at(0.0), e.position_at(1.0)


def _sample(e: Edge, n: int = 41) -> list[Vector]:
    return [e.position_at(i / (n - 1)) for i in range(n)]


def _reverse(e: Edge) -> Edge:
    return e.reversed()


def _shared(e: Edge, f: Edge):
    ae = _edge_ends(e)
    af = _edge_ends(f)
    return min((_dist(ae[i], af[j]), i, j) for i in range(2) for j in range(2))


def _surface_plane(origin, axis, xdir) -> Plane:
    return Plane(origin=origin, z_dir=axis, x_dir=xdir)


def _cyl_side(fid: str, radius: float, length: float = 80.0) -> Face:
    s = CYL[fid]
    axis = _v(s.axis).normalized()
    origin = _v(s.loc) - axis * (0.5 * length)
    solid = Solid.make_cylinder(radius, length, _surface_plane(origin, axis, s.xdir))
    faces = list(solid.faces().filter_by(GeomType.CYLINDER))
    if len(faces) != 1:
        raise RuntimeError(f"{fid}: expected one cylindrical side face, got {len(faces)}")
    return faces[0]


